{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc", "import", "vitest"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }]
  },
  "overrides": [
    {
      "files": ["src/domain/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["*", "**", "!./*", "!./**"],
                "message": "domain/ is a pure ring: it may import only src/domain/** and src/types/**. This file sits deeper than src/domain/<dir>/<file>, a depth the boundary rule does not model, so only same-subtree imports are allowed. Flatten the file or add a matching depth override to .oxlintrc.json."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/domain/*"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["*", "**", "!./*", "!./**", "!../types/*", "!../types/**"],
                "message": "domain/ is a pure ring: it may import only src/domain/** and src/types/**. Everything else — third-party packages, node builtins, and every other src/ ring — is denied by default."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/domain/*/*"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "*",
                  "**",
                  "!./*",
                  "!./**",
                  "!../*",
                  "!../*/*",
                  "!../../types/*",
                  "!../../types/**"
                ],
                "message": "domain/ is a pure ring: it may import only src/domain/** and src/types/**. Everything else — third-party packages, node builtins, and every other src/ ring — is denied by default."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/types/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["*", "**"],
                "message": "types/ is the leaf ring: it must import nothing."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/services/storage/*"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["*", "**", "!./*", "!../../types/*", "!../../domain/*/*"],
                "message": "services/storage/ sits below stores/ and features/: it may import only src/types/**, src/domain/** and its own siblings. Importing upward would invert the dependency and make persistence untestable without the UI. Report problems through setStorageErrorHandler instead."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/services/storage/*.test.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "*",
                  "**",
                  "!./*",
                  "!../../types/*",
                  "!../../domain/*/*",
                  "!vitest"
                ],
                "message": "A storage test may import exactly what the modules under test may import, plus the bare `vitest` specifier."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/stores/*"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "*",
                  "**",
                  "!./*",
                  "!../types/*",
                  "!../domain/*/*",
                  "!../services/storage/*",
                  "!zustand"
                ],
                "message": "stores/ orchestrates: it may import src/types/**, src/domain/**, the services/storage public surface, its sibling stores and zustand. No React, no features/, no components/ — a store that needs those is holding UI concerns."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/stores/*.test.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "*",
                  "**",
                  "!./*",
                  "!../types/*",
                  "!../domain/*/*",
                  "!../services/storage/*",
                  "!zustand",
                  "!vitest"
                ],
                "message": "A store test may import exactly what the store under test may import, plus the bare `vitest` specifier."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/domain/*/*.test.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "*",
                  "**",
                  "!./*",
                  "!./**",
                  "!../*",
                  "!../*/*",
                  "!../../types/*",
                  "!../../types/**",
                  "!vitest"
                ],
                "message": "A domain test may import exactly what the module under test may import, plus the bare `vitest` specifier. No React, no stores, no utils/ — if a domain test needs those, the logic under test is in the wrong ring."
              }
            ]
          }
        ]
      }
    }
  ]
}
