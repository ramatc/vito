{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc", "import", "vitest"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }]
  },
  "overrides": [
    {
      "files": ["src/domain/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "react",
                  "react-*",
                  "zustand",
                  "zustand/*",
                  "framer-motion",
                  "lucide-react",
                  "**/services/**",
                  "**/stores/**",
                  "**/features/**",
                  "**/components/**",
                  "**/hooks/**"
                ],
                "message": "domain/ is a pure ring: it may import only src/domain/** and src/types/**."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/types/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["*", "**"],
                "message": "types/ is the leaf ring: it must import nothing."
              }
            ]
          }
        ]
      }
    }
  ]
}
